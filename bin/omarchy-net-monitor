#!/usr/bin/env python3
"""
omarchy-net-monitor - Lightweight Network Usage Monitor for Omarchy Linux.
Tracks active network session data and daily data usage with persistence and midnight rollover.
"""

import sys
import os
import json
import time
import signal
import argparse
import fcntl
import shutil
import subprocess
from datetime import datetime

# Configure GLib and NetworkManager
import gi
gi.require_version('NM', '1.0')
from gi.repository import GLib, Gio, NM

XDG_RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
RUN_DIR = os.path.join(XDG_RUNTIME_DIR, "omarchy-net")
STATE_DIR = os.path.expanduser("~/.local/state/omarchy/network-usage")
PERSIST_FILE = os.path.join(STATE_DIR, "daily.json")
RUN_SESSION_FILE = os.path.join(RUN_DIR, "session.json")
RUN_DAILY_FILE = os.path.join(RUN_DIR, "daily.json")
LOCK_FILE = os.path.join(RUN_DIR, "monitor.lock")

# Versions before the widget owned the daemon were installed as a copied script plus a
# systemd user service. Both write the same state files as this monitor.
LEGACY_UNIT = "omarchy-net-monitor.service"
LEGACY_BIN = os.path.expanduser("~/.local/bin/omarchy-net-monitor")
LEGACY_UNIT_FILE = os.path.expanduser(f"~/.config/systemd/user/{LEGACY_UNIT}")
LEGACY_WANTS_LINK = os.path.expanduser(f"~/.config/systemd/user/default.target.wants/{LEGACY_UNIT}")
LEGACY_SIGNATURE = "omarchy-net-monitor - Lightweight Network Usage Monitor"
HISTORY_BACKUP = PERSIST_FILE + ".pre-migration"
LOCK_TIMEOUT = float(os.environ.get("OMARCHY_NET_LOCK_TIMEOUT", "15"))

def format_bytes(num_bytes):
    b = max(0, int(num_bytes))
    mb = b / (1024 * 1024)
    if mb < 10.0:
        return f"{mb:.1f} MB"
    elif mb < 1000.0:
        return f"{int(round(mb))} MB"
    else:
        gb = b / (1024 * 1024 * 1024)
        return f"{gb:.2f} GB"

def is_physical_interface(iface):
    # In Linux, physical network interfaces have a device symlink in sysfs
    return os.path.islink(f"/sys/class/net/{iface}/device")

def read_proc_net_dev():
    counters = {}
    try:
        with open("/proc/net/dev", "r") as f:
            lines = f.readlines()
        for line in lines[2:]:
            parts = line.split(":")
            if len(parts) == 2:
                iface = parts[0].strip()
                fields = parts[1].split()
                rx = int(fields[0])
                tx = int(fields[8])
                counters[iface] = (rx, tx)
    except Exception as e:
        pass
    return counters

def write_atomic(filepath, content):
    os.makedirs(os.path.dirname(filepath), exist_ok=True)
    tmp_path = filepath + f".tmp.{os.getpid()}"
    with open(tmp_path, "w", encoding="utf-8") as f:
        f.write(content)
    os.replace(tmp_path, filepath)

def log(msg):
    print(f"[omarchy-net-monitor] {msg}", file=sys.stderr, flush=True)

def acquire_single_instance(timeout=LOCK_TIMEOUT):
    """Hold an exclusive lock for the life of the process, so two monitors can never
    write the same usage state. Waits briefly, because a restarting widget starts the
    new monitor while the old one is still exiting. Returns the fd, or None."""
    os.makedirs(RUN_DIR, exist_ok=True)
    fd = os.open(LOCK_FILE, os.O_RDWR | os.O_CREAT, 0o600)
    deadline = time.monotonic() + timeout
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            os.ftruncate(fd, 0)
            os.write(fd, f"{os.getpid()}\n".encode())
            return fd
        except OSError:
            if time.monotonic() >= deadline:
                os.close(fd)
                return None
            time.sleep(0.2)

def _systemctl(*args, timeout=30):
    try:
        return subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None

def _is_legacy_monitor_file(path):
    try:
        with open(path, "rb") as f:
            return LEGACY_SIGNATURE in f.read(2048).decode("utf-8", "replace")
    except OSError:
        return False

def _unit_runs_legacy_monitor():
    """True only for the unit the old installer wrote, not one the user made their own."""
    try:
        with open(LEGACY_UNIT_FILE, "r", encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        return False
    return any(l.strip().startswith("ExecStart=") and "omarchy-net-monitor" in l for l in lines)

def _legacy_pids():
    """Our own user's processes running the copied script, wherever they were started from."""
    pids = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit() or int(entry) == os.getpid():
            continue
        try:
            if os.stat(f"/proc/{entry}").st_uid != os.getuid():
                continue
            with open(f"/proc/{entry}/cmdline", "rb") as f:
                argv = f.read().split(b"\0")
        except OSError:
            continue
        if LEGACY_BIN.encode() in argv[:3]:
            pids.append(int(entry))
    return pids

def _stop_pids(pids, grace=10.0):
    """SIGTERM makes the monitor write its counters to disk before it exits."""
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    deadline = time.monotonic() + grace
    while time.monotonic() < deadline and any(os.path.exists(f"/proc/{p}") for p in pids):
        time.sleep(0.2)
    for pid in [p for p in pids if os.path.exists(f"/proc/{p}")]:
        log(f"legacy monitor {pid} ignored SIGTERM; killing it (up to 30s of counts may be lost)")
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
    time.sleep(0.2)
    return not any(os.path.exists(f"/proc/{p}") for p in pids)

def retire_legacy_install():
    """Hand over from the old systemd service to the widget-owned monitor.

    Order matters for the history: the old monitor is stopped first, because it flushes its
    counters on SIGTERM, and only then does this process load daily.json. The history file
    is shared, so nothing is converted or lost; a copy is kept beside it before anything
    is touched. Returns False if the old monitor could not be stopped, in which case this
    process must not start: two writers would overwrite each other.
    """
    unit_present = os.path.exists(LEGACY_UNIT_FILE) or os.path.islink(LEGACY_UNIT_FILE)
    bin_present = os.path.exists(LEGACY_BIN)
    own_bin = bin_present and _is_legacy_monitor_file(LEGACY_BIN)
    pids = _legacy_pids() if (own_bin or not bin_present) else []
    if not (unit_present or own_bin or pids):
        return True

    log("found the old standalone monitor; retiring it before taking over")
    if os.path.isfile(PERSIST_FILE) and not os.path.exists(HISTORY_BACKUP):
        try:
            shutil.copy2(PERSIST_FILE, HISTORY_BACKUP)
            log(f"usage history backed up to {HISTORY_BACKUP}")
        except OSError as e:
            log(f"could not back up usage history: {e}")

    if unit_present and _unit_runs_legacy_monitor():
        # `disable --now` stops the service (SIGTERM, waits for exit) and stops it restarting.
        r = _systemctl("disable", "--now", LEGACY_UNIT)
        if r is None or r.returncode != 0:
            _systemctl("stop", LEGACY_UNIT)
            _systemctl("disable", LEGACY_UNIT)
        active = _systemctl("is-active", LEGACY_UNIT, timeout=10)
        if active is None or active.stdout.strip() in ("active", "activating", "reloading"):
            log("could not stop the legacy systemd service; not starting a second monitor")
            return False
        for path in (LEGACY_UNIT_FILE, LEGACY_WANTS_LINK):
            try:
                os.remove(path)
            except OSError:
                pass
        _systemctl("daemon-reload")
        _systemctl("reset-failed", LEGACY_UNIT, timeout=10)
        log(f"removed {LEGACY_UNIT}")
    elif unit_present:
        log(f"{LEGACY_UNIT_FILE} does not run the old monitor; leaving it alone")

    pids = _legacy_pids() if (own_bin or not bin_present) else []
    if pids and not _stop_pids(pids):
        log("could not stop the old monitor process; not starting a second monitor")
        return False

    if own_bin:
        try:
            os.remove(LEGACY_BIN)
            log(f"removed {LEGACY_BIN}")
        except OSError as e:
            log(f"could not remove {LEGACY_BIN}: {e}")

    for root in (os.path.expanduser("~/.config/hypr"), os.path.expanduser("~/.config/autostart")):
        for dirpath, _, files in os.walk(root):
            for name in files:
                path = os.path.join(dirpath, name)
                try:
                    with open(path, "r", encoding="utf-8", errors="ignore") as f:
                        if "omarchy-net-monitor" in f.read(200_000):
                            log(f"{path} still starts the old monitor; remove that line")
                except OSError:
                    pass
    return True

class NetworkMonitor:
    def __init__(self):
        self.nm_client = None
        try:
            self.nm_client = NM.Client.new(None)
        except Exception as e:
            print(f"[omarchy-net-monitor] Warning: Could not initialize NM.Client: {e}", file=sys.stderr)

        self.current_session_key = None
        self.current_conn_name = None
        self.current_iface = None
        self.session_rx = 0
        self.session_tx = 0
        self.prev_iface_rx = None
        self.prev_iface_tx = None

        self.today_date = None
        self.today_rx = 0
        self.today_tx = 0
        self.history = {}

        self.last_persist_time = 0
        self.dirty = False

        self.load_daily_state()

    def get_local_date_str(self):
        return datetime.now().astimezone().strftime("%Y-%m-%d")

    def load_daily_state(self):
        today = self.get_local_date_str()
        self.today_date = today
        self.today_rx = 0
        self.today_tx = 0
        self.history = {}

        if os.path.isfile(PERSIST_FILE):
            try:
                with open(PERSIST_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                saved_date = data.get("date")
                self.history = data.get("history", {})

                if saved_date == today:
                    self.today_rx = int(data.get("today_rx", 0))
                    self.today_tx = int(data.get("today_tx", 0))
                elif saved_date:
                    # Archive previous date to history
                    prev_rx = int(data.get("today_rx", 0))
                    prev_tx = int(data.get("today_tx", 0))
                    self.history[saved_date] = {
                        "rx": prev_rx,
                        "tx": prev_tx,
                        "total": prev_rx + prev_tx
                    }
                    self.dirty = True
            except Exception as e:
                print(f"[omarchy-net-monitor] Error loading daily state: {e}", file=sys.stderr)

        # Prune history older than 14 days
        if len(self.history) > 14:
            sorted_dates = sorted(self.history.keys())
            for old_date in sorted_dates[:-14]:
                self.history.pop(old_date, None)

    def save_daily_state(self, force=False):
        now_ts = time.time()
        if not force and not self.dirty:
            return
        if not force and (now_ts - self.last_persist_time < 30):
            return

        os.makedirs(STATE_DIR, exist_ok=True)
        data = {
            "date": self.today_date,
            "today_rx": self.today_rx,
            "today_tx": self.today_tx,
            "today_total": self.today_rx + self.today_tx,
            "updated_at": datetime.now().astimezone().isoformat(),
            "history": self.history
        }
        try:
            write_atomic(PERSIST_FILE, json.dumps(data, indent=2) + "\n")
            self.last_persist_time = now_ts
            self.dirty = False
        except Exception as e:
            print(f"[omarchy-net-monitor] Error saving daily state: {e}", file=sys.stderr)

    def check_midnight_rollover(self):
        current_date = self.get_local_date_str()
        if current_date != self.today_date:
            # Midnight has passed!
            self.history[self.today_date] = {
                "rx": self.today_rx,
                "tx": self.today_tx,
                "total": self.today_rx + self.today_tx
            }
            # Prune history
            if len(self.history) > 14:
                sorted_dates = sorted(self.history.keys())
                for old_date in sorted_dates[:-14]:
                    self.history.pop(old_date, None)

            self.today_date = current_date
            self.today_rx = 0
            self.today_tx = 0
            self.dirty = True
            self.save_daily_state(force=True)

    def detect_active_connection(self):
        """
        Returns (is_active, conn_name, iface, session_key)
        """
        if self.nm_client:
            try:
                prim = self.nm_client.get_primary_connection()
                if prim and prim.get_state() == NM.ActiveConnectionState.ACTIVATED:
                    devs = prim.get_devices() or []
                    for dev in devs:
                        iface = dev.get_iface()
                        if iface and iface != "lo" and is_physical_interface(iface):
                            s_key = f"{prim.get_uuid()}:{prim.get_path()}"
                            return True, prim.get_id() or iface, iface, s_key

                # Fallback: scan active connections for activated physical devices
                for ac in self.nm_client.get_active_connections() or []:
                    if ac.get_state() == NM.ActiveConnectionState.ACTIVATED:
                        if ac.get_connection_type() in ("802-11-wireless", "802-3-ethernet", "gsm", "cdma"):
                            for dev in ac.get_devices() or []:
                                iface = dev.get_iface()
                                if iface and iface != "lo" and is_physical_interface(iface):
                                    s_key = f"{ac.get_uuid()}:{ac.get_path()}"
                                    return True, ac.get_id() or iface, iface, s_key
            except Exception as e:
                pass

        # Fallback without NetworkManager: check /proc/net/route for default gateway
        try:
            with open("/proc/net/route", "r") as f:
                for line in f.readlines()[1:]:
                    parts = line.split()
                    if len(parts) >= 3 and parts[1] == "00000000": # Destination default
                        iface = parts[0]
                        if iface != "lo" and is_physical_interface(iface):
                            return True, iface, iface, f"kernel:{iface}"
        except Exception:
            pass

        return False, None, None, None

    def tick(self):
        self.check_midnight_rollover()
        net_dev = read_proc_net_dev()

        is_active, conn_name, iface, session_key = self.detect_active_connection()

        if is_active:
            # Active connection present
            rx_now, tx_now = net_dev.get(iface, (0, 0))

            if self.current_session_key != session_key:
                # New session started!
                self.current_session_key = session_key
                self.current_conn_name = conn_name
                self.current_iface = iface
                self.session_rx = 0
                self.session_tx = 0
                self.prev_iface_rx = rx_now
                self.prev_iface_tx = tx_now
            else:
                # Same session continuing - compute delta
                if self.prev_iface_rx is not None and self.prev_iface_tx is not None:
                    delta_rx = rx_now - self.prev_iface_rx
                    delta_tx = tx_now - self.prev_iface_tx

                    # Check for counter reset / wrap (e.g. driver reloaded or device reset)
                    if delta_rx < 0 or delta_tx < 0:
                        delta_rx = rx_now if delta_rx < 0 else delta_rx
                        delta_tx = tx_now if delta_tx < 0 else delta_tx

                    if delta_rx > 0 or delta_tx > 0:
                        self.session_rx += delta_rx
                        self.session_tx += delta_tx
                        self.today_rx += delta_rx
                        self.today_tx += delta_tx
                        self.dirty = True

                self.prev_iface_rx = rx_now
                self.prev_iface_tx = tx_now

            # Output Session Indicator
            session_total = self.session_rx + self.session_tx
            session_data = {
                "text": f"↕ {format_bytes(session_total)}",
                "tooltip": (
                    f"Session: {format_bytes(session_total)} (Down: {format_bytes(self.session_rx)}, Up: {format_bytes(self.session_tx)})\n"
                    f"Connection: {self.current_conn_name} ({self.current_iface})\n"
                    f"Note: Estimated interface traffic"
                )
            }
            write_atomic(RUN_SESSION_FILE, json.dumps(session_data) + "\n")

        else:
            # Disconnected
            if self.current_session_key is not None:
                # Just transitioned to disconnected
                self.save_daily_state(force=True)

            self.current_session_key = None
            self.current_conn_name = None
            self.current_iface = None
            self.session_rx = 0
            self.session_tx = 0
            self.prev_iface_rx = None
            self.prev_iface_tx = None

            # When disconnected, empty session file hides indicator
            write_atomic(RUN_SESSION_FILE, "")

        # Output Daily Indicator (always visible)
        daily_total = self.today_rx + self.today_tx
        daily_data = {
            "text": f"▦ {format_bytes(daily_total)}",
            "tooltip": (
                f"Today: {format_bytes(daily_total)} (Down: {format_bytes(self.today_rx)}, Up: {format_bytes(self.today_tx)})\n"
                f"Daily network traffic estimate (resets at local midnight)\n"
                f"Date: {self.today_date}"
            )
        }
        write_atomic(RUN_DAILY_FILE, json.dumps(daily_data) + "\n")

        self.save_daily_state()
        return True

    def on_prepare_for_sleep(self, is_sleeping):
        if is_sleeping:
            # Going to sleep: flush state to disk
            self.save_daily_state(force=True)
        else:
            # Woke up: check midnight rollover & reset prev counters
            self.check_midnight_rollover()
            self.prev_iface_rx = None
            self.prev_iface_tx = None

def main():
    parser = argparse.ArgumentParser(description="Omarchy Network Usage Monitor")
    parser.add_argument("--status", action="store_true", help="Print current session and daily usage status")
    parser.add_argument("--oneshot", action="store_true", help="Perform one sample check and write files, then exit")
    parser.add_argument("--reset-session", action="store_true", help="Reset active session counter to zero")
    parser.add_argument("--reset-daily", action="store_true", help="Reset today's daily counter to zero")
    parser.add_argument("--migrate-legacy", action="store_true", help="Retire the old standalone service/script install, then exit")
    args = parser.parse_args()

    one_shot = args.status or args.oneshot or args.reset_session or args.reset_daily

    if args.migrate_legacy:
        sys.exit(0 if retire_legacy_install() else 1)

    if not one_shot:
        # Daemon mode: be the only writer, and retire any old install, before loading state.
        lock_fd = acquire_single_instance()
        if lock_fd is None:
            log("another monitor is already running; exiting")
            sys.exit(1)
        if not retire_legacy_install():
            sys.exit(2)

    monitor = NetworkMonitor()

    if args.reset_daily:
        monitor.today_rx = 0
        monitor.today_tx = 0
        monitor.dirty = True
        monitor.save_daily_state(force=True)
        print("Daily counter reset to 0.")
        return

    if args.reset_session:
        monitor.session_rx = 0
        monitor.session_tx = 0
        monitor.prev_iface_rx = None
        monitor.prev_iface_tx = None
        print("Session counter reset to 0.")
        return

    if args.status or args.oneshot:
        monitor.tick()
        active = monitor.current_session_key is not None
        status = {
            "connected": active,
            "connection": monitor.current_conn_name,
            "interface": monitor.current_iface,
            "session_rx": monitor.session_rx,
            "session_tx": monitor.session_tx,
            "session_total": monitor.session_rx + monitor.session_tx,
            "session_formatted": format_bytes(monitor.session_rx + monitor.session_tx),
            "date": monitor.today_date,
            "daily_rx": monitor.today_rx,
            "daily_tx": monitor.today_tx,
            "daily_total": monitor.today_rx + monitor.today_tx,
            "daily_formatted": format_bytes(monitor.today_rx + monitor.today_tx),
        }
        print(json.dumps(status, indent=2))
        return

    # Daemon mode
    loop = GLib.MainLoop()

    def handle_signal(sig, frame):
        monitor.save_daily_state(force=True)
        loop.quit()

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    # Listen to system sleep/resume signals
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        def on_sleep_signal(conn, sender, path, iface, sig, params, user_data):
            is_sleep = params.unpack()[0]
            monitor.on_prepare_for_sleep(is_sleep)

        bus.signal_subscribe(
            'org.freedesktop.login1',
            'org.freedesktop.login1.Manager',
            'PrepareForSleep',
            '/org/freedesktop/login1',
            None,
            Gio.DBusSignalFlags.NONE,
            on_sleep_signal,
            None
        )
    except Exception as e:
        print(f"[omarchy-net-monitor] Warning: Could not subscribe to sleep signals: {e}", file=sys.stderr)

    # Initial tick
    monitor.tick()

    # Periodic sampling every 2 seconds
    GLib.timeout_add_seconds(2, monitor.tick)

    loop.run()

if __name__ == "__main__":
    main()
